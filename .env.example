# ═══════════════════════════════════════════════════════════════════
#  DSH + QQ Bot 配置
#
#  复制成 .env 然后填这几项就够了：
#    QQBOT_APPID / QQBOT_SECRET   或留空走扫码
#
#  模型（服务商 / API key / 默认模型）不用在这里填：
#    打开 http://127.0.0.1:8766  →  设置  →  模型
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
#  模型：不需要在这里配
# ═══════════════════════════════════════════════════════════════
#
# 服务商、模型、默认模型、API key 全部在 Web 界面里配：
#   http://127.0.0.1:8766  →  设置  →  模型
#
# DSH 自带 42 个服务商的内置目录（DeepSeek / OpenAI / Anthropic /
# Kimi / Moonshot / 通义 …），baseUrl、模型列表、上下文窗口都在目录里，
# 你只要选一个、填 API key 就行。
#
# 镜像预置的是 DeepSeek 官方（provider=deepseek，模型 deepseek-flash）。
# 在 Web 里改成别的服务商后，config-sync 会每 5 秒同步到 QQ 机器人，
# 不需要改这个文件、也不需要重启。
#
# 降级链（模型限流时自动换下一个）也是自动的：它等于「当前模型表里的
# 全部模型」，模型表变了它跟着变，同样不用配。

# ── 子智能体（可选）──
# 默认不启用子智能体的模型选择（跟随主模型）。
# 想启用：填一张 provider:model 白名单，主 Agent 会按这张表给子智能体挑模型。
# 格式：provider:model，逗号分隔
#   DSH_SUBAGENT_MODELS=deepseek:deepseek-flash
DSH_SUBAGENT_MODELS=

# 子智能体递归层级上限（子智能体再派子智能体…最多几层）
# 0 = 禁止递归；2~3 够用，太深容易失控
DSH_SUBAGENT_MAX_DEPTH=3

# 同时最多跑几个子智能体
DSH_SUBAGENT_MAX_PARALLEL=4
# ═══════════════════════════════════════════════════════════════
#  QQ Bot 凭据
# ═══════════════════════════════════════════════════════════════
# 两种方式，任选其一：
#
#   方式 A（推荐）扫码绑定
#     留空即可。首次启动时 dsh --profile qqbot 会打印二维码，
#     用手机 QQ 扫码完成绑定，凭据自动写入 data/profiles/qqbot/。
#     看二维码：docker compose logs -f dsh
#
#   方式 B 手工填
#     去 https://q.qq.com 创建机器人，把 AppID / AppSecret 填在这里。
#
QQBOT_APPID=
QQBOT_SECRET=

# ═══════════════════════════════════════════════════════════════
#  群聊门控（默认 open，一般不用改）
# ═══════════════════════════════════════════════════════════════
# 三档：open / allowlist / disabled
#   open      任何群都能用，@ 她才回（仍受 requireMention 约束）—— 默认
#   allowlist 只认 DSH_GROUP_ALLOW 里的群 openid
#   disabled  全部丢掉（别用，会让人以为机器人死了）
DSH_GROUP_MODE=open

# 只在 DSH_GROUP_MODE=allowlist 时才有意义。
# 怎么拿群 openid：机器人在群里被 @ 一次后，会话日志里会出现 "groupOpenid":"..."
DSH_GROUP_ALLOW=

# ═══════════════════════════════════════════════════════════════
