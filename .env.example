# ═══════════════════════════════════════════════════════════════
#  DSH + QQ Bot 配置
#
#  复制成 .env，填 QQ 凭据（或留空走扫码）就够了。
#
#  模型（服务商 / API key / 默认模型）不在这里配：
#    打开 http://127.0.0.1:8766  →  设置  →  模型
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
#  模型：不需要在这里配
# ═══════════════════════════════════════════════════════════════
#
# 服务商、模型、默认模型、API key 全部在 Web 界面里配：
#   http://127.0.0.1:8766  →  设置  →  模型
#
# DSH 自带 42 个服务商的内置目录（DeepSeek / OpenAI / Anthropic /
# Kimi / Moonshot / 通义 …），baseUrl、模型列表、上下文窗口都在目录里，
# 你只要选一个、填 API key 就行。
#
# �� DeepSeek 官方卡（provider=deepseek-official，模型 deepseek-flash）
# 是 dsh-base 自带的，不需要额外配置。
#
# ⚠️ 因为 Web 和 QQ 是同一个进程，在 Web 里改完模型 QQ 那边立刻跟随，
#    不需要重启、也不需要任何同步机制。

# ── 子智能体（可选）──
# 默认不启用子智能体的模型选择（全部跟随主模型）。
# 想启用：填一张 provider:model 白名单，主 Agent 会按这张表给子智能体挑模型。
# 格式：provider:model，逗号分隔
#   DSH_SUBAGENT_MODELS=deepseek-official:deepseek-flash
#
# ⚠️ 这不是自动降级链。默认模型请在 Web 顶部选择器里切。
DSH_SUBAGENT_MODELS=

# 子智能体递归层级上限（子智能体再派子智能体…最多几层）
# 0 = 禁止递归；2~3 够用，太深容易失控
DSH_SUBAGENT_MAX_DEPTH=3

# 同时最多跑几个子智能体
DSH_SUBAGENT_MAX_PARALLEL=4

# ═══════════════════════════════════════════════════════════════
#  QQ Bot 凭据
# ═══════════════════════════════════════════════════════════════
# 两种方式，任选其一：
#
#   方式 A（推荐）扫码绑定
#     留空即可。启动后打开 Web UI，侧栏有「QQ Bot 绑定」页，
#     扫码即绑，绑定后立即生效，**不需要重启容器**。
#     终端日志里也会打印二维码作为降级通道。
#
#   方式 B 手工填
#     去 https://q.qq.com 创建机器人，把 AppID / AppSecret 填在这里。
#
# ⚠️ 不要同时往 data/profiles/main/cordis.patch.yml 里写死凭据：
#    插件是「config 优先、env 兜底」，写死会让扫码结果失效。
QQBOT_APPID=
QQBOT_SECRET=

# ═══════════════════════════════════════════════════════════════
#  群聊门控（默认 open，一般不用改）
# ═══════════════════════════════════════════════════════════════
# 三档：open / allowlist / disabled
#   open      任何群都能用，@ 她才回（仍受 requireMention 约束）—— 默认
#   allowlist 只认 DSH_GROUP_ALLOW 里的群 openid
#   disabled  全部丢掉（别用，会让人以为机器人死了）
DSH_GROUP_MODE=open

# 只在 DSH_GROUP_MODE=allowlist 时才有意义。
# 怎么拿群 openid：机器人在群里被 @ 一次后，会话日志里会出现 "groupOpenid":"..."
DSH_GROUP_ALLOW=

# ═══════════════════════════════════════════════════════════════
#  重点人员（可选）
# ═══════════════════════════════════════════════════════════════
# 填 QQ openid（不是 QQ 号），逗号分隔。
# 这些人没 @ 也会把她叫起来看一眼群里在聊什么，但**不一定回** ——
# 回不回由她自己判断（不输出文本 = 不回）。
#
# 留空 = 只认 @。
#
# 怎么拿自己的 openid：先 @ 她一次，然后
#   docker compose exec dsh bash -lc 'zstd -d -c ~/.dsh/sessions/-workspace-/*/session.v4.jsonl.zstd | grep -o "\[.* ([0-9A-F]\{32\})\]" | head -3'
DSH_VIP_SENDERS=

# ═══════════════════════════════════════════════════════════════
#  资源限制（可选）
# ═══════════════════════════════════════════════════════════════
DSH_CPUS=3.0
DSH_MEM=4g

# Web UI 映射到宿主机的端口（只绑 127.0.0.1）
# WEB_HOST_PORT=8766
