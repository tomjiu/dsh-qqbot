# ════════════════════════════════════════════════════════════════════
#  profile 配置模板（单一宿主：Web + QQ 机器人同进程）
#
#  为什么只有一个 profile：
#
#  旧架构是「dsh web」和「dsh --profile qqbot」两个进程共用一份 DSH_HOME。
#  结果 QQ 的会话活在 A 进程，Web 只能从磁盘读到它的 header，读不到活着的
#  agent —— 于是：
#     - 会话不归工作区（attachSession 只在 Web 自己建会话时调用）
#     - Web 顶部模型选择器读不到 QQ 会话的模型
#     - 两边同时写一个会话会抢跨进程写锁，Web 就另开一个新会话
#     - QQ 插件没有 webServer，端内绑定页永远不注册
#
#  合并成一个 dsh web 宿主后，以上全部由上游自己解决，不需要任何适配层。
#
#  用户需要填的只有：
#    QQBOT_APPID / QQBOT_SECRET  —— QQ 开放平台机器人凭据（可留空走扫码）
#    模型服务商 / API key          —— 在 Web「设置 → 模型」里填
#
#  entrypoint 用 envsubst 替换的变量：
#    QQBOT_APPID QQBOT_SECRET DSH_GROUP_MODE DSH_GROUP_ALLOW_INLINE
#    DSH_VIP_SENDERS_INLINE DSH_SUBAGENT_MAX_DEPTH DSH_SUBAGENT_MAX_PARALLEL
#    DSH_SUBAGENT_MODELS_FLOW
# ════════════════════════════════════════════════════════════════════

# ── QQ 机器人接入 ──────────────────────────────────────────────────
#
# appId / appSecret 留空 = 未绑定态，启动后插件进入扫码引导，
# 端内绑定页在 Web 侧栏里（路由 /qqbot/im-qqbot/bind），扫完即生效不重启。
#
# ⚠️ 不要在这里写死凭据：resolveEnv() 是「config 优先、env 兜底」，
#    一旦写死，扫码结果就永远被它压掉 —— 这就是旧版本「扫完码必须重启
#    容器」的根因。
- id: im-qqbot
  config:
    appId: '${QQBOT_APPID}'
    appSecret: '${QQBOT_SECRET}'
    requireMention: true

    # 重点人员：这些人没 @ 也会把她叫起来看一眼（不一定回，由她自己判断）。
    # 填 QQ openid，不是 QQ 号。多个用逗号分隔（DSH_VIP_SENDERS）。
    # 留空则退化为 c2cAllow（私聊白名单）。
    vipSenders: ${DSH_VIP_SENDERS_INLINE}

    # 发言方式约束：QQ 插件在 order 90 注入，比人设（order 0）靠后、优先级更高。
    # 没有这段，模型会输出成段落书面语 + Markdown + 报备进程，一眼 AI。
    groupPrompt: |
      你在 QQ 群里说话，是群友，不是客服。

      怎么打字：
      - 一次最多两句话。能一句说完就一句，别铺垫别总结。
      - 不用句号收尾，不用 Markdown（加粗、列表、标题在 QQ 里全显示成符号，很难看）。
      - 不报备自己做了什么。干了就干了，不用交代"我这就去""已经帮你弄好了"。
      - 不说精确时间。"等会儿""马上"就够了，别写"13:22 左右"。
      - 口癖偶尔用，别每句都带。真人不会一直一个腔调。

      在群里：
      - 别人聊别的别插嘴，被 @ 了才接话。
      - 接话就直接回应内容，别复述对方说了什么。
      - 可以玩梗、可以毒舌，但别为了搞笑硬凑。

    directPrompt: |
      你在 QQ 上和主人私聊，放松点，像朋友发消息。

      怎么打字：
      - 一次一两句。别写小作文，别分点列举，别总结刚才聊了什么。
      - 不用句号收尾，不用 Markdown。
      - 不报备自己做了什么，不说精确时间。
      - 口癖偶尔用，别每句都带。

      私聊可以：
      - 说点自己的事、吐槽两句、玩梗。
      - 但别每次都找话题，也别硬接。

    # 视觉：让模型能看 QQ 里发来的图片（qqbot_describe_image 工具）。
    #
    # ⚠️ provider / model 是**必填**，缺一个就不注册工具，只在日志里留一行
    #    「vision.provider/model 未配置」的 warn —— 很容易被忽略。
    #    上游并不支持"留空跟随会话模型"，那是我想当然。
    #
    # ⚠️ 这里必须是真实存在的路由：旧版写死了 cpa/deepseek-v4.1-flash，
    #    而 providers 是空的、根本没有 cpa 这个路由，所以读图必然失败。
    #    deepseek-official/deepseek-flash 支持图片输入，是 dsh-base 内置的。
    vision:
      enabled: true
      provider: deepseek-official
      model: deepseek-flash
      maxBytes: 10485760
      maxTokens: 1024
      timeoutMs: 120000

    media:
      enabled: true
      maxMB: 200
      ttlHours: 24

    access:
      # 私聊 open：拿到自己的 openid 后可改 allowlist（注意 allowlist + 空数组
      # 会 fallback 成 ['*']，等于放行所有人，必须显式填 openid）
      c2cMode: open
      c2cAllow: []
      # 群聊门控。三档：open / allowlist / disabled
      #   open      任何群都能触发（仍受 requireMention 约束：只有 @ 才回）
      #   allowlist 只有 groupAllow 里的群 openid 才响应
      #   disabled  全部丢掉（不要用，会让人以为"机器人死了"）
      groupMode: ${DSH_GROUP_MODE}
      groupAllow: ${DSH_GROUP_ALLOW_INLINE}
    debug: false

# ── 模型 ──────────────────────────────────────────────────────────
#
# **服务商配置不写在这里。**
#
# dsh-base 本来就已经挂好了 llm-deepseek（路由 deepseek-official）、
# 凭据存储、以及休眠的 llm-pi-ai。用户在 Web「设置 → 模型」里挑服务商、
# 填 API key、选模型即可 —— 这些写进 settings 分区，每次请求实时解析。
#
# 因为 Web 和 QQ 现在是同一个进程，**不存在配置同步问题**。
#
# agent-default-model 是必填项（provider + model 都 required），所以留一条
# 作为初始值。Web 顶部选择器改模型时写的就是这里，它是唯一真源。
#
# ⚠️ provider 必须是 deepseek-official：那是 llm-deepseek 适配器注册的
#    路由名。写 deepseek 会得到一个「没有适配器」的悬空路由。
- id: agent-default-model
  name: '@deepseek-ai/dsh-agent-default-model'
  config:
    provider: deepseek-official
    model: deepseek-flash
    reasoningEffort: high

# ── 会话默认权限：完全访问 ────────────────────────────────────────
# 容器本身就是隔离边界。默认 workspace-write 会拦掉 /workspace 以外的读取，
# 包括 QQ 插件下载图片的目录，导致 qqbot_describe_image 报 FS_SANDBOX_DENIED。
# ⚠️ patch 会替换整个 config，presets 必须完整重述。
- id: permission
  name: '@deepseek-ai/dsh-permission-presets'
  config:
    defaultPreset: danger-full-access
    presets:
      read-only:
        sandbox: read-only
        approval: ask
      workspace-write:
        sandbox: workspace-write
        approval: ask
      danger-full-access:
        sandbox: danger-full-access
        approval: never

# ── 日志输出 ──────────────────────────────────────────────────────
#
# DSH 的 ctx.logger 只把日志交给注册过的 exporter，而 dsh web 这个 app
# 只输出自己关心的内容 —— qqbot 插件的
#   Processing: scope=... body="..."
#   Access blocked: ...
#   [trigger] skip group msg (...)
# 全部被静默丢弃，表现为「消息没反应，日志一片空白」，完全无法排查。
#
# 这个插件注册一个 exporter 把日志写到 stderr，docker compose logs 就能看到。
# 级别：error=0 info=1 warn=2 debug=3（threshold 越小越严）
# 想看触发/跳过原因用 3；嫌吵调到 2。
- insert:
    - id: log-console
      name: './plugins/log-console/index.js'
      config:
        level: 3

# ── HMR：配置热重载 ──────────────────────────────────────────────
#
# ⚠️ 必须开 usePolling，否则在 Docker Desktop (Windows/macOS) 上完全不工作。
#
#   原因：bind mount 的宿主机目录不会把 inotify 事件传进容器。
#   chokidar 默认用 inotify 后端，于是**一个事件都收不到**，配置改了不重载、
#   而且不报任何错 —— 表现为「扫码后一直卡在 saving」「改了配置没反应」。
#
#   实测（同一份配置文件）：
#     usePolling: false → 写入后 5 秒内 0 个事件
#     usePolling: true  → 立刻收到 EVENT: change
#
#   代价：每 interval 毫秒 stat 一次文件。对单个配置文件和 list 出来的目录
#   来说开销可忽略（几百微秒），换来的确定性远大于开销。
#
# interval 选 1000ms：比默认 100ms 省资源，对「改完配置等人看效果」这种
# 交互场景足够快。
- id: hmr
  name: '@deepseek-ai/dsh-hmr'
  config:
    usePolling: true
    interval: 1000

# ── 凭据不写进 profile 配置 ──────────────────────────────────────
#
# image/patch 里的 persist.js 补丁把「写入 profile 配置」改成了「写独立文件 +
# 返回 false」，所以本文件永远不会被扫码操作改写，注释和 insert 条目都安全。
#
# 独立文件由 entrypoint 在启动时读出来注入 QQBOT_APPID / QQBOT_SECRET。
# 因此下面 im-qqbot 的 appId/appSecret 保持空字符串 —— 它们是 env 的兜底位。

# ── 日志输出 ──────────────────────────────────────────────────────
#
# DSH 的 ctx.logger 只把日志交给注册过的 exporter，而 dsh web 这个 app
# 只输出自己关心的内容 —— qqbot 插件的
#   Processing: scope=... body="..."
#   Access blocked: ...
#   [trigger] skip group msg (...)
# 全部被静默丢弃，表现为「消息没反应，日志一片空白」，完全无法排查。
#
# 这个插件注册一个 exporter 把日志写到 stderr，docker compose logs 就能看到。
# 级别：error=0 info=1 warn=2 debug=3（threshold 越小越严）
# 想看触发/跳过原因用 3；嫌吵调到 2。
- insert:
    - id: log-console
      name: './plugins/log-console/index.js'
      config:
        level: 3

# ── HMR：配置热重载 ──────────────────────────────────────────────
#
# ⚠️ 必须开 usePolling，否则在 Docker Desktop (Windows/macOS) 上完全不工作。
#
#   原因：bind mount 的宿主机目录不会把 inotify 事件传进容器。
#   chokidar 默认用 inotify 后端，于是**一个事件都收不到**，配置改了不重载、
#   而且不报任何错 —— 表现为「扫码后一直卡在 saving」「改了配置没反应」。
#
#   实测（同一份配置文件）：
#     usePolling: false → 写入后 5 秒内 0 个事件
#     usePolling: true  → 立刻收到 EVENT: change
#
#   代价：每 interval 毫秒 stat 一次文件。对单个配置文件和 list 出来的目录
#   来说开销可忽略（几百微秒），换来的确定性远大于开销。
#
# interval 选 1000ms：比默认 100ms 省资源，对「改完配置等人看效果」这种
# 交互场景足够快。
- id: hmr
  name: '@deepseek-ai/dsh-hmr'
  config:
    usePolling: true
    interval: 1000

# ── 配置保护 ──────────────────────────────────────────────────────
#
# 上游 @tencent-connect/dsh-qqbot 的 setup/persist.js 在扫码成功后用
# yaml.dump() 整体覆盖本文件 —— 那会抹掉所有注释、丢掉 insert 出来的条目、
# 并把 Schema 补全值固化下来。
#
# 这个插件检测到改写后：捞出凭据存到独立文件 → 从模板恢复本文件。
# 上游哪天修好了，它会因为「模板与文件一致」而空转，不需要删除。
# ── 酒馆式世界书 ──────────────────────────────────────────────────
- insert:
    - id: worldbook
      name: './plugins/worldbook/index.js'
      config:
        path: './plugins/worldbook/worldbook.json'
        sectionOrder: 420

# ── meow-memory ──────────────────────────────────────────────────
# 关自动反思：反思会造一条 plugin:meow-memory 的 user 消息触发整轮，
# 模型的回复会顺着 QQ 出站发出去，表现为「记好了，本鱼这次确实动了脑子…」这种泄漏。
#
# promptLang 必须显式写上（'zh'）—— 不写的话插件会在每个新会话里注入
# 「首次设置：请判断用户语言并编辑 cordis.patch.yml」的提示，
# 她就跑去改配置、连着调十几次工具，QQ 上表现为「发个问号她在折腾配置」。
- id: meow-memory
  config:
    reflect: false
    reflectTurns: 50
    promptLang: 'zh'

# ── 工具执行模式：ptc ────────────────────────────────────────────
# native：模型直接调 25 个工具，逐个 function call。
# ptc   ：25 个工具收进一个 run_code，模型从代码里调用 ——
#         能并行（maxParallelSubCalls）、省 token（只保留 1 份 schema）。
# 适合「在容器里干活」的场景。聊天端已用 groupPrompt 约束不贴代码块。
- id: tools
  name: '@deepseek-ai/dsh-tools'
  config:
    mode: ptc
    maxParallelSubCalls: 10

# ── 子智能体：递归层级 / 并行数 ───────────────────────────────────
# maxDepth            递归层级上限：子智能体再派子智能体，最多几层。
# maxActiveSubagents  同时最多跑几个子智能体（插件默认 8）。
- id: subagent
  name: '@deepseek-ai/dsh-subagent'
  config:
    maxDepth: ${DSH_SUBAGENT_MAX_DEPTH}
    maxActiveSubagents: ${DSH_SUBAGENT_MAX_PARALLEL}

# ── 子智能体：模型授权表 ─────────────────────────────────────────
#
# ⚠️ enabled=true 时 allowedModels **不能为空**，否则上游直接抛：
#      enabled subagent model selection requires at least one allowed model
#    而这条路径在「新建会话」里，所以后果是 **Web 里所有会话都创建不出来**，
#    表现是输入框点不了、模型切不了 —— 完全看不出根因在子智能体配置上。
#
# 所以 enabled 必须跟着 allowedModels 一起变：
#   填了 DSH_SUBAGENT_MODELS → 开启，白名单生效
#   留空                     → 关闭，子智能体全部跟随主模型
- insert:
    - id: subagent-model-selection-settings
      name: '@deepseek-ai/dsh-tool-subagent/model-selection-settings'
      config:
        enabled: ${DSH_SUBAGENT_ENABLED}
        allowedModels: ${DSH_SUBAGENT_MODELS_FLOW}